meta {
  name: ADMIN-crud read course
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/admin/courses/{{createdCourseId}}
}

vars:pre-request {
  actor: admin
}

tests {
  test("reads the owned course with an empty curriculum", function() {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(bru.getVar("createdCourseId"));
    expect(res.body.chapter).to.be.an("array").that.is.empty;
  });
}
