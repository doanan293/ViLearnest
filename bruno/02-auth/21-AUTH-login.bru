meta {
  name: AUTH-login
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/api/auth/sign-in/email
  body: json
}

headers {
  content-type: application/json
  origin: {{frontendUrl}}
}

body:json {
  {
    "email": "{{learnerAEmail}}",
    "password": "{{learnerAPassword}}"
  }
}

vars:pre-request {
  actor: anonymous
}

script:post-response {
  if (res.status !== 200 || res.body.user.id !== bru.getVar("learnerAUserId")) throw new Error("Learner A login returned an unexpected account");
  const rawCookies = res.headers["set-cookie"];
  const cookies = Array.isArray(rawCookies) ? rawCookies : [rawCookies];
  const session = cookies.find((cookie) => cookie && /(?:__Secure-)?better-auth\.session_token=/.test(cookie));
  if (!session) throw new Error("Better Auth learner session cookie is missing");
  bru.setVar("session.learnerA", session.split(";")[0]);
}

tests {
  test("logs in the verified learner A fixture", function() {
    expect(res.status).to.equal(200);
    expect(res.body.user).to.have.property("id", bru.getVar("learnerAUserId"));
    expect(res.body.user).to.have.property("emailVerified", true);
    expect(bru.getVar("session.learnerA")).to.be.a("string");
  });
}
