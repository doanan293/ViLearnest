meta {
  name: Require session: GET /api/v1/admin/lessons/:id
  type: http
  seq: 80
}

get {
  url: {{baseUrl}}/api/v1/admin/lessons/{{activeLessonId}}
}


vars:pre-request {
  actor: anonymous
}

tests {
