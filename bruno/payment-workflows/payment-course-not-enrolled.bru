meta {
  name: Payment Course Not Enrolled
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/courses/{{paymentCourseId}}/is-enrolled
}

tests {
  test("reports the payment course is not enrolled before checkout", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("enrolled", false);
  });
}
