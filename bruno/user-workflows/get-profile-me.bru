meta {
  name: Get Profile Me
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/profile/me
}

tests {
  test("returns the seeded user profile", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("id", bru.getEnvVar("seededUserId"));
    expect(res.body).to.have.property("email", bru.getEnvVar("userEmail"));
    expect(res.body).to.have.property("profile").that.is.an("object");
  });
}
