meta {
  name: Course Enroll Invalid Body
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/api/v1/courses/enroll
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {}
}

tests {
  test("rejects invalid enroll body for an authenticated user", function() {
    expect(res.status).to.equal(400);
    expect(res.body).to.have.property("status", "error");
    expect(res.body).to.have.property("message").that.is.a("string");
  });
}
