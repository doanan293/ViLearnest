meta {
  name: User Forbidden Admin Create Course
  type: http
  seq: 25
}

post {
  url: {{baseUrl}}/api/v1/admin/courses
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "title": "Blocked User Course",
    "description": "{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"This request should be blocked before course creation.\"}]}]}",
    "fileKey": "bruno-fixtures/blocked-user-course-cover.png",
    "price": 0,
    "duration": 10,
    "level": "Beginner",
    "category": "Testing",
    "smallDescription": "Permission matrix course body.",
    "slug": "bruno-user-forbidden-course",
    "status": "Draft"
  }
}

tests {
  test("normal user cannot create admin courses", function() {
    expect(res.status).to.equal(403);
    expect(res.body).to.have.property("status", "error");
    expect(res.body).to.have.property("message").that.includes("Administrator");
  });
}
