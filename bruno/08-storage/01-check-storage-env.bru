meta {
  name: Check storage provider credentials
  type: http
  seq: 2
}

get {
  url: {{helperUrl}}/api/v1/bruno-desktop/storage-env
}

headers {
  x-bruno-helper-token: {{brunoDesktopHelperToken}}
}

vars:pre-request {
  actor: external
}

script:pre-request {
  req.setHeader("x-bruno-helper-token", bru.getEnvVar("brunoDesktopHelperToken"));
}

tests {
  test("requires the configured S3-compatible test environment", function() {
    expect(res.status).to.equal(200);
  });
}
