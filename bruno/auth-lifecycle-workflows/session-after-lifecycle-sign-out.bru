meta {
  name: Session After Lifecycle Sign Out
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/v1/auth/session
}

tests {
  test("does not return a session after lifecycle sign-out", function() {
    expect(res.status).to.equal(401);
    expect(res.body).to.have.property("status", "error");
    expect(res.body).to.have.property("message").that.includes("unauthorized");
  });
}
