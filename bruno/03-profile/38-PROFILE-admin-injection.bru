meta {
  name: PROFILE-admin-injection
  type: http
  seq: 40
}

put {
  url: {{baseUrl}}/api/v1/admin/users/{{learnerBId}}/profile
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "Injected Role Change",
    "email": "attacker@example.com",
    "role": "admin"
  }
}

vars:pre-request {
  actor: admin
}

tests {
  test("ignores attempted email and role changes from the profile body", function() {
    expect(res.status).to.equal(200);
    expect(res.body.name).to.equal("Injected Role Change");
    expect(res.body.email).to.equal(bru.getVar("learnerBEmail"));
    expect(res.body.role).to.equal("user");
  });
}
