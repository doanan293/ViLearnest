meta {
  name: Presign Upload Smoke
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/storage/presigned
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "filename": "bruno-upload-smoke.txt",
    "contentType": "text/plain"
  }
}

script:post-response {
  bru.setVar("uploadedStorageKey", res.body.key);
  bru.setVar("uploadUrl", res.body.uploadUrl);
}

tests {
  test("creates a presigned URL for smoke upload", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("uploadUrl").that.is.a("string");
    expect(res.body).to.have.property("key").that.is.a("string");
    expect(res.body.key).to.include("bruno-");
  });
}
