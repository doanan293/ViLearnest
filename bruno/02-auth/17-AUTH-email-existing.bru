meta {
  name: 17-AUTH-email-existing
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/api/v1/auth/email-exists
  body: json
}

headers {
  content-type: application/json
}

body:json {
  { "email": "{{learnerAEmail}}" }
}

vars:pre-request {
  actor: anonymous
}

tests {
  test("17-AUTH-email-existing", function() {
    expect(res.status).to.equal(200);
    expect(res.body.exists).to.equal(true);
  });
}
