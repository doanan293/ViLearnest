meta {
  name: Public Created Course Visible
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/api/v1/courses/by-slug/{{adminCourseSlug}}
}

tests {
  test("shows the published API-created course publicly", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("id", bru.getVar("adminCreatedCourseId"));
    expect(res.body).to.have.property("slug", bru.getEnvVar("adminCourseSlug"));
  });
}
