        <!-- Right Side: Bruno Git-friendly Approach -->
        <mxCell id="c_bruno" value="GIẢI PHÁP BRUNO GIT-FRIENDLY WORKFLOW" style="swimlane;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#F0FFF4;strokeColor=#38A169;fontColor=#276749;" vertex="1" parent="1">
          <mxGeometry x="530" y="70" width="430" height="480" as="geometry" />
