meta {
  name: AUTH-direct-session-anonymous
  type: http
  seq: 53
}

get {
  url: {{baseUrl}}/api/auth/session
}

vars:pre-request {
  actor: anonymous
}

tests {
  test("returns no direct Better Auth session anonymously", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.deep.equal({ status: "error", message: "Unauthorized" });
  });
}
