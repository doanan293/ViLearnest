meta {
  name: AUTH-old-password
  type: http
  seq: 42
}

post {
  url: {{baseUrl}}/api/auth/sign-in/email
  body: json
}

headers {
  content-type: application/json
  origin: {{frontendUrl}}
}

body:json {
  {
    "email": "{{learnerAEmail}}",
    "password": "{{learnerAPassword}}"
  }
}

vars:pre-request {
  actor: anonymous
}

tests {
  test("rejects the old password after reset", function() {
    expect(res.status).to.equal(401);
  });
}
