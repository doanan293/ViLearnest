meta {
  name: Upload Course Cover
  type: http
  seq: 5
}

put {
  url: {{uploadUrl}}
  body: file
}

headers {
  content-type: image/png
}

body:file {
  file: @file(fixtures/course-cover.png) @contentType(image/png)
}

tests {
  test("uploads the course cover through the presigned URL", function() {
    expect([200, 204]).to.include(res.status);
  });
}
