meta {
  name: Payment Course Lesson Content
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/v1/courses/lessons/{{paymentLessonId}}
}

tests {
  test("returns lesson content for the activated payment course", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("id", bru.getEnvVar("paymentLessonId"));
    expect(res.body.Chapter.Course).to.have.property("id", bru.getEnvVar("paymentCourseId"));
  });
}
