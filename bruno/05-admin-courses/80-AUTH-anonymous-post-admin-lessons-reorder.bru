meta {
  name: Require session: POST /api/v1/admin/lessons/reorder
  type: http
  seq: 80
}

post {
  url: {{baseUrl}}/api/v1/admin/lessons/reorder
  body: json
}

headers {
  content-type: application/json
}

body:json {
  { "items": [{ "id": "{{activeLessonId}}", "position": 1 }] }
}


vars:pre-request {
  actor: anonymous
}

tests {
  test("rejects an anonymous request before business mutations", function() {
    expect(res.status).to.equal(401);
  });
}
