meta {
  name: PUBLIC-visibility
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/v1/courses
}

vars:pre-request {
  actor: anonymous
}

tests {
  test("lists published courses without draft or archived fixtures", function() {
    expect(res.status).to.equal(200);
    expect(res.body.some((course) => course.slug === bru.getVar("publishedSlug"))).to.equal(true);
    expect(res.body.some((course) => course.slug === bru.getVar("draftSlug"))).to.equal(false);
    expect(res.body.some((course) => course.slug === bru.getVar("archivedSlug"))).to.equal(false);
  });
}
