meta {
  name: Login User
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/sign-in/email
  body: json
}

headers {
  content-type: application/json
  origin: {{frontendUrl}}
}

body:json {
  {
    "email": "{{userEmail}}",
    "password": "{{userPassword}}"
  }
}

script:post-response {
  if (res.body && res.body.token) {
    bru.setVar("authToken", res.body.token);
  }
}

tests {
  test("logs in the seeded user", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("token").that.is.a("string");
    expect(res.body.user).to.have.property("email", bru.getEnvVar("userEmail"));
    expect(res.body.user).to.have.property("role", "user");
  });
}
