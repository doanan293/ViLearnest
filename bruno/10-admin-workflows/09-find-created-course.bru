meta {
  name: Find Created Course
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/v1/admin/courses
}

script:post-response {
  const course = res.body.find((item) => item.slug === bru.getEnvVar("adminCourseSlug"));
  if (!course) {
    throw new Error("Admin-created Bruno course was not found in admin list");
  }
  bru.setVar("adminCreatedCourseId", course.id);
}

tests {
  test("finds the API-created course id", function() {
    expect(res.status).to.equal(200);
    const course = res.body.find((item) => item.slug === bru.getEnvVar("adminCourseSlug"));
    expect(course).to.be.an("object");
    expect(course).to.have.property("id").that.is.a("string");
    expect(course).to.have.property("fileKey", bru.getVar("courseCoverKey"));
  });
}
