meta {
  name: 44-AUTH-request-signin-otp
  type: http
  seq: 44
}

post {
  url: {{baseUrl}}/api/auth/email-otp/send-verification-otp
  body: json
}

headers {
  content-type: application/json
  origin: {{frontendUrl}}
}

body:json {
  { "email": "{{learnerAEmail}}", "type": "sign-in" }
}

vars:pre-request {
  actor: anonymous
}

tests {
  test("44-AUTH-request-signin-otp", function() {
    expect(res.status).to.equal(200);
  });
}
