meta {
  name: Storage Presigned Invalid Body
  type: http
  seq: 27
}

post {
  url: {{baseUrl}}/api/v1/storage/presigned
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "filename": ""
  }
}

tests {
  test("rejects invalid presigned upload body before S3 access", function() {
    expect(res.status).to.equal(400);
    expect(res.body).to.have.property("status", "error");
    expect(res.body).to.have.property("message").that.is.a("string");
  });
}
