        </mxCell>

        <mxCell id="br_benefit" value="LỢI ÍCH: An toàn thông tin tuyệt đối, quản lý như artifact mã nguồn, dễ audit &amp; tự động hóa CLI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#38A169;strokeColor=#276749;fontSize=11;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="c_bruno">
