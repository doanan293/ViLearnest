meta {
  name: ADMIN-authorization learner denied course update
  type: http
  seq: 33
}

put {
  url: {{baseUrl}}/api/v1/admin/courses/{{publishedCourseId}}
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "titleEn": "Forbidden learner update",
    "descriptionEn": "{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\"}]}",
    "fileKey": "forbidden.png",
    "price": 0,
    "duration": 10,
    "level": "Beginner",
    "category": "Testing",
    "smallDescriptionEn": "Forbidden",
    "slug": "bruno-admin-{{runId}}",
    "status": "Published"
  }
}

vars:pre-request {
  actor: learnerA
}

tests {
  test("denies valid course update payload to an authenticated learner", function() { expect(res.status).to.equal(403); });
}
