meta {
  name: AUTH-request-reset
  type: http
  seq: 30
}

post {
  url: {{baseUrl}}/api/auth/email-otp/request-password-reset
  body: json
}

headers {
  content-type: application/json
  origin: {{frontendUrl}}
}

body:json {
  {
    "email": "{{learnerAEmail}}"
  }
}

vars:pre-request {
  actor: anonymous
}

tests {
  test("requests a password reset code for the owned account", function() {
    expect(res.status).to.equal(200);
  });
}
