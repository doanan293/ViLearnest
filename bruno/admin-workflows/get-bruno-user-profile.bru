meta {
  name: Get Bruno User Profile
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/admin/users/{{seededUserId}}/profile
}

tests {
  test("returns the seeded user profile to admin", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("id", bru.getEnvVar("seededUserId"));
    expect(res.body).to.have.property("email", bru.getEnvVar("userEmail"));
    expect(res.body).to.have.property("profile").that.is.an("object");
  });
}
