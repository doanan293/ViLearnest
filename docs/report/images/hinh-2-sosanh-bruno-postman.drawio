        </mxCell>

        <mxCell id="br_step2" value="Giảm thiểu tối đa xung đột mã nguồn khi nhiều người làm việc song song" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#38A169;fontSize=11;" vertex="1" parent="c_bruno">
          <mxGeometry x="30" y="240" width="370" height="45" as="geometry" />
        </mxCell>

        <mxCell id="br_step3" value="Hoàn toàn 100% Offline, lưu trữ cục bộ dưới sự kiểm soát của dự án" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#38A169;fontSize=11;" vertex="1" parent="c_bruno">
