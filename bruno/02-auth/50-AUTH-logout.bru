meta {
  name: AUTH-logout
  type: http
  seq: 50
}

post {
  url: {{baseUrl}}/api/auth/sign-out
}

headers {
  origin: {{frontendUrl}}
}

vars:pre-request {
  actor: learnerA
}

tests {
  test("signs out the active learner A session", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("success", true);
  });
}
