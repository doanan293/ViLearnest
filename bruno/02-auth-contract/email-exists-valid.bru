meta {
  name: Email Exists Valid
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/email-exists
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "email": "bruno-smoke@example.com"
  }
}

tests {
  test("returns 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("returns an existence boolean", function() {
    expect(res.body).to.have.property("exists").that.is.a("boolean");
  });
}
