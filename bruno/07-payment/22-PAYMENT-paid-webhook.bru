meta {
  name: PAYMENT-paid activate through signed Stripe webhook
  type: http
  seq: 23
}

post {
  url: {{baseUrl}}/api/v1/webhooks/stripe
  body: text
}

headers {
  content-type: application/json
}

body:text {
  {}
}

vars:pre-request {
  actor: external
}

script:pre-request {
  req.setHeader("stripe-signature", bru.getVar("paymentWebhookSignature"));
  req.setBody(bru.getVar("paymentWebhookPayload"), { raw: true });
}

tests {
  test("accepts the valid signed paid event", function() {
    expect(res.status).to.equal(200);
    expect(res.body.received).to.equal(true);
  });
}
