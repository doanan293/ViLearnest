{
  "name": "vilearnest-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@vilearnest/backend & npm run dev --workspace=@vilearnest/frontend",
    "build": "npm run build --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=@vilearnest/backend",
    "db:migrate": "npm run db:migrate --workspace=@vilearnest/backend",
    "db:import-courses": "npm run db:import-courses --workspace=@vilearnest/backend",
    "test": "npm run test:unit",
    "test:watch": "npm run test:watch --workspaces --if-present",
    "biome:ci": "npm run biome:ci --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "check": "npm run check --workspaces --if-present && npm run check:boundaries",
    "test:api": "node bruno/tooling/run.mjs all",
    "test:api:smoke": "node bruno/tooling/run.mjs smoke",
    "test:api:workflows": "node bruno/tooling/run-bruno-workflows.mjs",
    "test:api:payment": "node bruno/tooling/run.mjs payment",
    "test:api:edge": "node bruno/tooling/run-bruno-edge-lifecycle.mjs",
    "test:api:all": "node bruno/tooling/run.mjs all",
    "bruno:helper": "tsx --env-file=backend/.env bruno/tooling/server.ts",
    "test:bruno:tooling": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --config bruno/jest.config.mjs",
    "test:integration": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --config backend/jest.integration.config.mjs",
    "check:bruno": "biome check bruno/tooling bruno/tests",
    "build:bruno": "tsc --project bruno/tsconfig.json --noEmit",
    "test:api:coverage": "tsx --env-file=backend/.env bruno/tooling/check-coverage.ts",
    "test:api:core": "node bruno/tooling/run.mjs core",
    "test:api:auth": "node bruno/tooling/run.mjs auth",
    "test:api:profile": "node bruno/tooling/run.mjs profile",
    "test:api:public-courses": "node bruno/tooling/run.mjs public-courses",
    "test:api:admin-courses": "node bruno/tooling/run.mjs admin-courses",
    "test:api:learning-access": "node bruno/tooling/run.mjs learning-access",
    "test:api:storage": "node bruno/tooling/run.mjs storage",
    "test:api:cleanup": "node bruno/tooling/run.mjs cleanup",
    "test:bruno:integration": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --config bruno/jest.integration.config.mjs",
    "typecheck:bruno:tests": "tsc --project bruno/tsconfig.tests.json --noEmit",
    "test:unit": "npm run test --workspaces --if-present && npm run test:bruno:tooling",
    "check:all": "npm run check && npm run check:bruno",
    "sample-courses:prepare": "node backend/scripts/prepare-youtube-sample-courses.mjs",
    "test:e2e": "npm run test:e2e --workspace=@vilearnest/frontend --",
    "test:e2e:install": "npm run test:e2e:install --workspace=@vilearnest/frontend",
    "check:boundaries": "node backend/scripts/check-boundaries.mjs"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@usebruno/cli": "3.5.0",
    "@usebruno/filestore": "0.10.0",
    "jest": "^30.4.2",
    "pptxgenjs": "^4.0.1",
    "ts-jest": "^29.4.11"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "uuid": "^13.0.2",
    "esbuild": "^0.28.1"
  }
}
