meta {
  name: Admin Update User Profile Valid
  type: http
  seq: 19
}

put {
  url: {{baseUrl}}/api/v1/admin/users/{{seededUserId}}/profile
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "Bruno Learner Managed",
    "phoneNumber": "+84901234567",
    "country": "Vietnam",
    "province": "Ho Chi Minh City",
    "occupation": "Managed by Bruno Phase D",
    "organization": "ANDV LMS",
    "bio": "Admin-managed profile update from Bruno Phase D."
  }
}

tests {
  test("admin updates the seeded user profile", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("id", bru.getEnvVar("seededUserId"));
    expect(res.body).to.have.property("email", bru.getEnvVar("userEmail"));
    expect(res.body).to.have.property("name", "Bruno Learner Managed");
    expect(res.body.profile).to.have.property("phoneNumber", "+84901234567");
    expect(res.body.profile).to.have.property("occupation", "Managed by Bruno Phase D");
  });
}
