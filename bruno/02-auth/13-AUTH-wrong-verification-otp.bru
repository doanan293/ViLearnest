meta {
  name: AUTH-wrong-verification-otp
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/auth/email-otp/verify-email
  body: json
}

headers {
  content-type: application/json
  origin: {{frontendUrl}}
}

body:json {
  {
    "email": "{{learnerAEmail}}",
    "otp": "000000"
  }
}

vars:pre-request {
  actor: anonymous
}

script:pre-request {
  const otp = bru.getVar("learnerAVerificationOtp");
  req.setBody(JSON.stringify({
    email: bru.getVar("learnerAEmail"),
    otp: otp === "000000" ? "000001" : "000000"
  }), { raw: true });
}

tests {
  test("rejects a wrong verification code without verifying the account", function() {
    expect(res.status).to.equal(400);
    expect(res.body).to.have.property("code", "INVALID_OTP");
  });
}
