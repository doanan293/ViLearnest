meta {
  name: Verify Admin Session
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/auth/session
}

tests {
  test("returns the active admin session", function() {
    expect(res.status).to.equal(200);
    expect(res.body.user).to.have.property("email", bru.getEnvVar("adminEmail"));
    expect(res.body.user).to.have.property("role", "admin");
    expect(res.body.session).to.have.property("userId", bru.getEnvVar("seededAdminId"));
  });
}
