meta {
  name: AUTH-reset-replay
  type: http
  seq: 41
}

post {
  url: {{baseUrl}}/api/auth/email-otp/reset-password
  body: json
}

headers {
  content-type: application/json
  origin: {{frontendUrl}}
}

body:json {
  {
    "email": "{{learnerAEmail}}",
    "otp": "{{learnerAResetOtp}}",
    "password": "{{lifecycleResetPassword}}"
  }
}

vars:pre-request {
  actor: anonymous
}

tests {
  test("rejects replay of the consumed reset code", function() {
    expect(res.status).to.equal(400);
    expect(res.body).to.have.property("code", "INVALID_OTP");
  });
}
