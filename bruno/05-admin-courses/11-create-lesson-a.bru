meta {
  name: ADMIN-order create lesson A
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/admin/chapters/{{createdChapterAId}}/lessons
  body: json
}

headers {
  content-type: application/json
}

body:json {
  { "nameEn": "Owned Lesson A" }
}

vars:pre-request {
  actor: admin
}

script:post-response {
  if (res.status === 200) bru.setVar("createdLessonAId", res.body.lesson.id);
}

tests {
  test("creates a lesson in chapter A", function() {
    expect(res.status).to.equal(200);
    expect(res.body.lesson.position).to.equal(1);
  });
}
