meta {
  name: Upload Lesson Video
  type: http
  seq: 9
}

put {
  url: {{uploadUrl}}
  body: file
}

headers {
  content-type: video/mp4
}

body:file {
  file: @file(fixtures/lesson-video.mp4) @contentType(video/mp4)
}

tests {
  test("uploads the lesson video through the presigned URL", function() {
    expect([200, 204]).to.include(res.status);
  });
}
