meta {
  name: PAYMENT-pending create Stripe test checkout
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/courses/enroll
  body: json
}

headers {
  content-type: application/json
}

body:json {
  { "courseId": "{{pendingCourseId}}" }
}

vars:pre-request {
  actor: learnerA
}

script:post-response {
  if (res.status === 200 && res.body.checkoutUrl) {
    const match = res.body.checkoutUrl.match(/cs_test_[A-Za-z0-9_]+/);
    if (!match) throw new Error("Stripe checkout session ID was not present in the checkout URL");
    bru.setVar("checkoutSessionId", match[0]);
    bru.setVar("checkoutUrl", res.body.checkoutUrl);
  }
}

tests {
  test("creates a real Stripe test checkout for the pending enrollment", function() {
    expect(res.status).to.equal(200);
    expect(res.body.checkoutUrl).to.include("cs_test_");
  });
}
