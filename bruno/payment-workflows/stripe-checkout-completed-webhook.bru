meta {
  name: Stripe Checkout Completed Webhook
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/webhooks/stripe
  body: text
}

headers {
  content-type: application/json
}

body:text {
  {}
}

script:pre-request {
  const payload = bru.getVar("paymentWebhookPayload") || bru.getEnvVar("paymentWebhookPayload");
  const signature = bru.getVar("paymentWebhookSignature") || bru.getEnvVar("paymentWebhookSignature");
  if (!payload) {
    throw new Error("paymentWebhookPayload is required");
  }
  if (!signature) {
    throw new Error("paymentWebhookSignature is required");
  }
  req.setHeader("stripe-signature", signature);
  req.setBody(payload, { raw: true });
}

tests {
  test("accepts the signed checkout completed webhook", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("received", true);
  });
}
