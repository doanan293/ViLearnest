meta {
  name: User Forbidden Admin Dashboard Stats
  type: http
  seq: 23
}

get {
  url: {{baseUrl}}/api/v1/admin/dashboard/stats
}

tests {
  test("normal user cannot read admin dashboard stats", function() {
    expect(res.status).to.equal(403);
    expect(res.body).to.have.property("status", "error");
    expect(res.body).to.have.property("message").that.includes("Administrator");
  });
}
