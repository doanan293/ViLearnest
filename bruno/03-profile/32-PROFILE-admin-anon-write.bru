meta {
  name: PROFILE-admin-anon-write
  type: http
  seq: 32
}

put {
  url: {{baseUrl}}/api/v1/admin/users/{{learnerBId}}/profile
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "Anonymous Must Not Update"
  }
}

vars:pre-request {
  actor: anonymous
}

tests {
  test("requires a session to update administrator user profiles", function() {
    expect(res.status).to.equal(401);
  });
}
