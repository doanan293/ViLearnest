meta {
  name: Setup auth fixtures
  type: http
  seq: 1
}

post {
  url: {{helperUrl}}/api/v1/bruno-desktop/runs/setup
  body: json
}

headers {
  content-type: application/json
  x-bruno-helper-token: {{brunoDesktopHelperToken}}
}

body:json {
  {
    "runId": "{{runId}}",
    "suite": "auth"
  }
}

vars:pre-request {
  actor: external
}

script:pre-request {
  bru.deleteAllVars();
  req.setHeader("x-bruno-helper-token", bru.getEnvVar("brunoDesktopHelperToken"));
  bru.setVar("fixtures", null);
  bru.setVar("session.admin", "");
  bru.setVar("session.learnerA", "");
  bru.setVar("session.learnerB", "");
  const provided = bru.getEnvVar("runId");
  if (provided) {
    bru.setVar("runId", provided);
  } else {
    const hex = "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(/[xy]/g, function(character) {
      const random = Math.floor(Math.random() * 16);
      return (character === "x" ? random : (random & 3) | 8).toString(16);
    });
    bru.setVar("runId", hex);
  }
  bru.setVar("suite", "auth");
}

script:post-response {
  if (res.status !== 200) throw new Error("Auth fixture setup failed: " + res.status);
  bru.setVar("fixtures", res.body);
  bru.setVar("learnerAEmail", res.body.actors.learnerA.email);
  bru.setVar("learnerAPassword", res.body.actors.learnerA.password);
  bru.setVar("learnerAId", res.body.actors.learnerA.id);
}

tests {
  test("creates fixtures scoped to this auth run", function() {
    expect(res.status).to.equal(200);
    expect(res.body.actors.learnerA.id).to.be.a("string");
  });
}
