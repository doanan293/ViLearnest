meta {
  name: Create Lesson
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/api/v1/admin/chapters/{{adminCreatedChapterId}}/lessons
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "Build Reliable API Tests With Bruno"
  }
}

script:post-response {
  bru.setVar("adminCreatedLessonId", res.body.lesson.id);
}

tests {
  test("creates a lesson in the API-created chapter", function() {
    expect(res.status).to.equal(200);
    expect(res.body.lesson).to.have.property("id").that.is.a("string");
    expect(res.body.lesson).to.have.property("title", "Build Reliable API Tests With Bruno");
  });
}
