        </mxCell>

        <mxCell id="br_file" value="Bru Markup Files (.bru)&#xa;Mỗi request là 1 file văn bản thuần plain-text độc lập" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#38A169;fontSize=11;fontStyle=1;" vertex="1" parent="c_bruno">
          <mxGeometry x="30" y="115" width="370" height="45" as="geometry" />
        </mxCell>

        <mxCell id="br_step1" value="Diff rõ ràng từng dòng code trên Git Pull Request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#38A169;fontSize=11;" vertex="1" parent="c_bruno">
