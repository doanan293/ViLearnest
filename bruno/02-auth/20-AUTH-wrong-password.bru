meta {
  name: AUTH-wrong-password
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/api/auth/sign-in/email
  body: json
}

headers {
  content-type: application/json
  origin: {{frontendUrl}}
}

body:json {
  {
    "email": "{{learnerAEmail}}",
    "password": "incorrect-password"
  }
}

vars:pre-request {
  actor: anonymous
}

tests {
  test("rejects a wrong learner password", function() {
    expect(res.status).to.equal(401);
  });
}
