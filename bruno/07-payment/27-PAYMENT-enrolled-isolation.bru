meta {
  name: PAYMENT-enrolled keep learner B locked
  type: http
  seq: 28
}

get {
  url: {{baseUrl}}/api/v1/courses/{{pendingCourseId}}/is-enrolled
}

vars:pre-request {
  actor: learnerB
}

tests {
  test("does not grant another learner access", function() {
    expect(res.status).to.equal(200);
    expect(res.body.enrolled).to.equal(false);
  });
}
