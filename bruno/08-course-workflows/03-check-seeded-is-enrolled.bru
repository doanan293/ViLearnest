meta {
  name: Check Seeded Is Enrolled
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/courses/{{seededCourseId}}/is-enrolled
}

tests {
  test("reports the seeded user is enrolled", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("enrolled", true);
  });
}
