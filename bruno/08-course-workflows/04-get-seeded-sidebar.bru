meta {
  name: Get Seeded Sidebar
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/courses/by-slug/{{seededCourseSlug}}/sidebar
}

tests {
  test("returns sidebar for enrolled seeded course", function() {
    expect(res.status).to.equal(200);
    expect(res.body.course).to.have.property("id", bru.getEnvVar("seededCourseId"));
    expect(res.body.course.chapter[0].lessons[0]).to.have.property("id", bru.getEnvVar("seededLessonId"));
  });
}
