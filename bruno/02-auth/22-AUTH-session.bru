meta {
  name: AUTH-session
  type: http
  seq: 22
}

get {
  url: {{baseUrl}}/api/v1/auth/session
}

vars:pre-request {
  actor: learnerA
}

tests {
  test("returns the authenticated learner A identity", function() {
    expect(res.status).to.equal(200);
    expect(res.body.user).to.have.property("id", bru.getVar("learnerAUserId"));
    expect(res.body.session).to.have.property("userId", bru.getVar("learnerAUserId"));
  });
}
