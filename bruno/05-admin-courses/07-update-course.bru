meta {
  name: ADMIN-crud update course
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/api/v1/admin/courses/{{createdCourseId}}
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "titleEn": "Bruno Owned Admin Course Updated",
    "descriptionEn": "{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\"}]}",
    "fileKey": "bruno-fixtures/{{runId}}/admin-course.png",
    "price": 0,
    "duration": 50,
    "level": "Intermediate",
    "category": "Testing",
    "smallDescriptionEn": "Updated owned course",
    "slug": "bruno-admin-{{runId}}",
    "status": "Published"
  }
}

vars:pre-request {
  actor: admin
}

tests {
  test("updates the owned course", function() {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("success");
  });
}
