meta {
  name: Sign Up Lifecycle User
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/sign-up/email
  body: json
}

headers {
  content-type: application/json
  origin: {{frontendUrl}}
}

body:json {
  {
    "name": "Bruno Auth Lifecycle",
    "email": "{{lifecycleEmail}}",
    "password": "{{lifecycleInitialPassword}}"
  }
}

script:post-response {
  if (res.body && res.body.user && res.body.user.id) {
    bru.setVar("lifecycleUserId", res.body.user.id);
  }
}

tests {
  test("signs up a Bruno-owned lifecycle user", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("token", null);
    expect(res.body.user).to.have.property("email", bru.getEnvVar("lifecycleEmail"));
    expect(res.body.user).to.have.property("emailVerified", false);
  });
}
