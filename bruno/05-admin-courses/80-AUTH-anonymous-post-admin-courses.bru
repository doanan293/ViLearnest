meta {
  name: Require session: POST /api/v1/admin/courses
  type: http
  seq: 80
}

post {
  url: {{baseUrl}}/api/v1/admin/courses
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "titleEn": "Forbidden learner course",
    "descriptionEn": "{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\"}]}",
    "fileKey": "forbidden.png",
    "price": 0,
    "duration": 10,
    "level": "Beginner",
    "category": "Testing",
    "smallDescriptionEn": "Forbidden",
    "slug": "bruno-forbidden-{{runId}}",
    "status": "Draft"
  }
}


vars:pre-request {
  actor: anonymous
}

tests {
  test("rejects an anonymous request before business mutations", function() {
    expect(res.status).to.equal(401);
  });
}
