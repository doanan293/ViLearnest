meta {
  name: AUTH-verification-otp
  type: http
  seq: 13
}

post {
  url: {{helperUrl}}/api/v1/bruno-desktop/runs/otp
  body: json
}

headers {
  content-type: application/json
  x-bruno-helper-token: {{brunoDesktopHelperToken}}
}

body:json {
  {
    "runId": "{{runId}}",
    "suite": "auth",
    "actor": "learnerA",
    "type": "email-verification"
  }
}

vars:pre-request {
  actor: external
}

script:post-response {
  if (res.body.email !== bru.getVar("learnerAEmail")) throw new Error("OTP belongs to a different account");
  bru.setVar("learnerAVerificationOtp", res.body.otp);
}

tests {
  test("returns the verification OTP for learner A only", function() {
    expect(res.status).to.equal(200);
    expect(res.body.email).to.equal(bru.getVar("learnerAEmail"));
    expect(res.body.otp).to.be.a("string");
  });
}
