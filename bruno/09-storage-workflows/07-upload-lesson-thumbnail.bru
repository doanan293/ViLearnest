meta {
  name: Upload Lesson Thumbnail
  type: http
  seq: 7
}

put {
  url: {{uploadUrl}}
  body: file
}

headers {
  content-type: image/png
}

body:file {
  file: @file(fixtures/lesson-thumbnail.png) @contentType(image/png)
}

tests {
  test("uploads the lesson thumbnail through the presigned URL", function() {
    expect([200, 204]).to.include(res.status);
  });
}
