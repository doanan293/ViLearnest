meta {
  name: Update Lesson
  type: http
  seq: 16
}

put {
  url: {{baseUrl}}/api/v1/admin/lessons/{{adminCreatedLessonId}}
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "Build Reliable API Tests With Bruno",
    "description": "{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Lesson media uploaded by Bruno through presigned storage URLs.\"}]}]}",
    "thumbnailKey": "{{lessonThumbnailKey}}",
    "videoKey": "{{lessonVideoKey}}"
  }
}

tests {
  test("updates the API-created lesson with uploaded media keys", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("status", "success");
  });
}
