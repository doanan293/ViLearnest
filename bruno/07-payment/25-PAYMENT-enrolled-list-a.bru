meta {
  name: PAYMENT-enrolled verify learner A enrolled list
  type: http
  seq: 26
}

get {
  url: {{baseUrl}}/api/v1/courses/enrolled
}

vars:pre-request {
  actor: learnerA
}

tests {
  test("includes the paid course in learner A's enrolled list", function() {
    expect(res.status).to.equal(200);
    expect(res.body.some((row) => row.courseId === bru.getVar("pendingCourseId"))).to.equal(true);
  });
}
