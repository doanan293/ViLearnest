meta {
  name: Require session: POST /api/v1/courses/checkout/confirm
  type: http
  seq: 80
}

post {
  url: {{baseUrl}}/api/v1/courses/checkout/confirm
  body: json
}

headers {
  content-type: application/json
}

body:json {
  { "sessionId": "{{checkoutSessionId}}" }
}


vars:pre-request {
  actor: anonymous
}

tests {
  test("rejects an anonymous request before business mutations", function() {
    expect(res.status).to.equal(401);
  });
}
