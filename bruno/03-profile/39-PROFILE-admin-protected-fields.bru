meta {
  name: PROFILE-admin-protected-fields
  type: http
  seq: 41
}

get {
  url: {{baseUrl}}/api/v1/admin/users/{{learnerBId}}/profile
}

vars:pre-request {
  actor: admin
}

tests {
  test("keeps email and role unchanged after attempted injection", function() {
    expect(res.status).to.equal(200);
    expect(res.body.email).to.equal(bru.getVar("learnerBEmail"));
    expect(res.body.role).to.equal("user");
    expect(res.body.name).to.equal("Injected Role Change");
  });
}
