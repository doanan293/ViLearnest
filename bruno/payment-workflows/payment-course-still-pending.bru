meta {
  name: Payment Course Still Pending
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/courses/{{paymentCourseId}}/is-enrolled
}

tests {
  test("does not activate enrollment before webhook", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("enrolled", false);
  });
}
