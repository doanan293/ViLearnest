meta {
  name: User Forbidden Admin Recent Courses
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/v1/admin/courses/recent
}

tests {
  test("normal user cannot read recent admin courses", function() {
    expect(res.status).to.equal(403);
    expect(res.body).to.have.property("status", "error");
    expect(res.body).to.have.property("message").that.includes("Administrator");
  });
}
