meta {
  name: STORAGE-upload verify image bytes
  type: http
  seq: 13
}

post {
  url: {{helperUrl}}/api/v1/bruno-desktop/runs/storage/inspect
  body: json
}

headers {
  content-type: application/json
  x-bruno-helper-token: {{brunoDesktopHelperToken}}
}

body:json {
  { "runId": "{{runId}}", "suite": "storage", "key": "{{imageKey}}" }
}

vars:pre-request {
  actor: external
}

script:pre-request {
  req.setHeader("x-bruno-helper-token", bru.getEnvVar("brunoDesktopHelperToken"));
}

tests {
  test("confirms image object length, type and SHA-256", function() {
    expect(res.status).to.equal(200);
    expect(res.body.exists).to.equal(true);
    expect(res.body.contentType).to.equal("image/png");
    expect(res.body.bytes).to.equal(68);
    expect(res.body.sha256).to.equal("4b5c5c92cec3b23e6a294fc0eea43234ef5126c5a64f4c6c531ac8430ab0b844");
  });
}
