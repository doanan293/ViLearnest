meta {
  name: Verify Direct Auth Session
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/auth/session
}

tests {
  test("returns the active lifecycle session through the direct Better Auth route", function() {
    expect(res.status).to.equal(200);
    expect(res.body.user).to.have.property("email", bru.getEnvVar("lifecycleEmail"));
    expect(res.body.session).to.have.property("userId").that.is.a("string");
  });
}
