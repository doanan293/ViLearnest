meta {
  name: Login storage learner
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/sign-in/email
  body: json
}

headers {
  content-type: application/json
  origin: {{frontendUrl}}
}

body:json {
  {
    "email": "{{learnerAEmail}}",
    "password": "{{learnerAPassword}}"
  }
}

vars:pre-request {
  actor: anonymous
}

script:post-response {
  if (res.status !== 200 || res.body.user.id !== bru.getVar("learnerAId")) throw new Error("Storage learner login failed");
  const rawCookies = res.headers["set-cookie"];
  const cookies = Array.isArray(rawCookies) ? rawCookies : [rawCookies];
  const session = cookies.find((cookie) => cookie && /(?:__Secure-)?better-auth\.session_token=/.test(cookie));
  if (!session) throw new Error("Storage learner session cookie is missing");
  bru.setVar("session.learnerA", session.split(";")[0]);
}

tests {
  test("authenticates the learner that requests upload URLs", function() {
    expect(res.status).to.equal(200);
    expect(res.body.user.id).to.equal(bru.getVar("learnerAId"));
  });
}
