meta {
  name: PAYMENT-invalid build unpaid signed event
  type: http
  seq: 10
}

post {
  url: {{helperUrl}}/api/v1/bruno-desktop/runs/payment/event
  body: json
}

headers {
  content-type: application/json
  x-bruno-helper-token: {{brunoDesktopHelperToken}}
}

body:json {
  { "runId": "{{runId}}", "suite": "payment", "variant": "unpaid" }
}

vars:pre-request {
  actor: external
}

script:pre-request {
  req.setHeader("x-bruno-helper-token", bru.getEnvVar("brunoDesktopHelperToken"));
}

script:post-response {
  bru.setVar("unpaidWebhookPayload", res.body.payload);
  bru.setVar("unpaidWebhookSignature", res.body.signature);
}

tests {
  test("builds the unpaid variant from this run's pending enrollment", function() { expect(res.status).to.equal(200); });
}
