meta {
  name: Presign Lesson Video
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/storage/presigned
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "filename": "bruno-lesson-video.mp4",
    "contentType": "video/mp4"
  }
}

script:post-response {
  bru.setVar("lessonVideoKey", res.body.key);
  bru.setVar("uploadUrl", res.body.uploadUrl);
}

tests {
  test("creates a presigned URL for the lesson video", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("uploadUrl").that.is.a("string");
    expect(res.body).to.have.property("key").that.is.a("string");
    expect(res.body.key).to.include("bruno-");
  });
}
