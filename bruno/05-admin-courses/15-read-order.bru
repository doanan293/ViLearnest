meta {
  name: ADMIN-order verify exact positions
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/api/v1/admin/courses/{{createdCourseId}}
}

vars:pre-request {
  actor: admin
}

tests {
  test("reads back exact chapter and lesson sibling positions", function() {
    expect(res.status).to.equal(200);
    expect(res.body.chapter[0]).to.include({ id: bru.getVar("createdChapterBId"), position: 1 });
    expect(res.body.chapter[1]).to.include({ id: bru.getVar("createdChapterAId"), position: 2 });
    expect(res.body.chapter[1].lessons[0]).to.include({ id: bru.getVar("createdLessonBId"), position: 1 });
    expect(res.body.chapter[1].lessons[1]).to.include({ id: bru.getVar("createdLessonAId"), position: 2 });
  });
}
