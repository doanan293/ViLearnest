meta {
  name: Desktop Export Auth Lifecycle OTP
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/bruno-desktop/auth-lifecycle-otp
  body: json
}

headers {
  content-type: application/json
  x-bruno-helper-token: {{brunoDesktopHelperToken}}
}

body:json {
  {
    "type": "forget-password"
  }
}

script:post-response {
  bru.setVar("lifecycleEmail", res.body.lifecycleEmail);
  bru.setVar("lifecycleOtp", res.body.lifecycleOtp);
}

tests {
  test("exports auth lifecycle OTP runtime variables", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("lifecycleEmail", "bruno-auth-lifecycle@example.com");
    expect(res.body).to.have.property("lifecycleOtp").that.is.a("string");
  });
}
