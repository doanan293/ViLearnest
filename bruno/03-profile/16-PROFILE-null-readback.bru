meta {
  name: PROFILE-null-readback
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/api/v1/profile/me
}

vars:pre-request {
  actor: learnerA
}

tests {
  test("persists cleared fields on the next read", function() {
    expect(res.status).to.equal(200);
    expect(res.body.profile.phoneNumber).to.equal(null);
    expect(res.body.profile.websiteUrl).to.equal(null);
  });
}
