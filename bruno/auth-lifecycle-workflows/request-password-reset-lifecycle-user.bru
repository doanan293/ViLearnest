meta {
  name: Request Password Reset Lifecycle User
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/email-otp/request-password-reset
  body: json
}

headers {
  content-type: application/json
  origin: {{frontendUrl}}
}

body:json {
  {
    "email": "{{lifecycleEmail}}"
  }
}

tests {
  test("requests a password reset OTP for the lifecycle user", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("success", true);
  });
}
