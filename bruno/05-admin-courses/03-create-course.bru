meta {
  name: ADMIN-crud create course
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/admin/courses
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "titleEn": "Bruno Owned Admin Course",
    "descriptionEn": "{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Owned admin workflow course\"}]}]}",
    "fileKey": "bruno-fixtures/{{runId}}/admin-course.png",
    "price": 0,
    "duration": 45,
    "level": "Beginner",
    "category": "Testing",
    "smallDescriptionEn": "Owned admin workflow",
    "slug": "bruno-admin-{{runId}}",
    "status": "Published"
  }
}

vars:pre-request {
  actor: admin
}

tests {
  test("creates a course through the admin API", function() {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("success");
  });
}
