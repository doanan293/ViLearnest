meta {
  name: AUTH-consumed-verification-otp
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/api/auth/email-otp/verify-email
  body: json
}

headers {
  content-type: application/json
  origin: {{frontendUrl}}
}

body:json {
  {
    "email": "{{learnerAEmail}}",
    "otp": "{{learnerAVerificationOtp}}"
  }
}

vars:pre-request {
  actor: anonymous
}

tests {
  test("rejects replay of the consumed verification code", function() {
    expect(res.status).to.equal(400);
    expect(res.body).to.have.property("code", "INVALID_OTP");
  });
}
