meta {
  name: Cleanup storage run and recover owned objects
  type: http
  seq: 99
}

post {
  url: {{helperUrl}}/api/v1/bruno-desktop/runs/cleanup
  body: json
}

headers {
  content-type: application/json
  x-bruno-helper-token: {{brunoDesktopHelperToken}}
}

body:json {
  { "runId": "{{runId}}", "suite": "storage" }
}

vars:pre-request {
  actor: external
}

script:pre-request {
  req.setHeader("x-bruno-helper-token", bru.getEnvVar("brunoDesktopHelperToken"));
}

tests {
  test("cleans the run and reports no provider objects left behind", function() {
    expect(res.status).to.equal(200);
    expect(res.body.remaining).to.deep.equal([]);
  });
}
