meta {
  name: PROFILE-invalid-preserves-state
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/api/v1/profile/me
}

vars:pre-request {
  actor: learnerA
}

tests {
  test("keeps the previous profile after rejected updates", function() {
    expect(res.status).to.equal(200);
    expect(res.body.name).to.equal("Bruno Profile A");
    expect(res.body.profile.phoneNumber).to.equal("+84 901 234 567");
    expect(res.body.profile.websiteUrl).to.equal("https://example.com/profile-a");
  });
}
