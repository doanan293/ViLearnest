meta {
  name: Dashboard Stats
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/admin/dashboard/stats
}

tests {
  test("returns admin dashboard stats", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("totalSignups").that.is.a("number");
    expect(res.body).to.have.property("totalCustomers").that.is.a("number");
    expect(res.body).to.have.property("totalCourses").that.is.a("number");
    expect(res.body).to.have.property("totalLessons").that.is.a("number");
  });
}
