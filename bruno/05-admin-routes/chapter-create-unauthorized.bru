meta {
  name: Admin Chapter Create Unauthorized
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/admin/courses/missing-course-id/chapters
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "Bruno Unauthorized Chapter"
  }
}

tests {
  test("returns 401 Unauthorized", function() {
    expect(res.status).to.equal(401);
  });

  test("returns the standard error shape", function() {
    expect(res.body).to.have.property("status", "error");
    expect(res.body).to.have.property("message").that.is.a("string");
  });

  test("does not expose implementation details", function() {
    const serialized = JSON.stringify(res.body).toLowerCase();
    expect(serialized).to.not.include("stack");
    expect(serialized).to.not.include("postgres");
    expect(serialized).to.not.include("sql");
    expect(serialized).to.not.include("/home/");
    expect(serialized).to.not.include("secret");
    expect(serialized).to.not.include("password");
  });
}
