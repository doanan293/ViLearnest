        <mxCell id="br_folder" value="Thư mục Collection phân tách theo nghiệp vụ&#xa;(bruno/system, bruno/auth, bruno/admin, bruno/payment...)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C6F6D5;strokeColor=#38A169;fontSize=11;fontStyle=1;" vertex="1" parent="c_bruno">
