meta {
  name: Delete Course Cover
  type: http
  seq: 10
}

delete {
  url: {{baseUrl}}/api/v1/storage/files
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "key": "{{courseCoverKey}}"
  }
}

tests {
  test("deletes the course cover through the backend API", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("message").that.is.a("string");
  });
}
