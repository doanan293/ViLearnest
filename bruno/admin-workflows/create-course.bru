meta {
  name: Create Course
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/admin/courses
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "title": "Bruno API Automation Course",
    "description": "{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Course created by Bruno authenticated API workflow.\"}]}]}",
    "fileKey": "{{courseCoverKey}}",
    "price": 0,
    "duration": 45,
    "level": "Beginner",
    "category": "Testing",
    "smallDescription": "Course created by Bruno API automation.",
    "slug": "{{adminCourseSlug}}",
    "status": "Published"
  }
}

tests {
  test("creates a real admin course", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("status", "success");
    expect(res.body).to.have.property("message").that.includes("Course created");
  });
}
