meta {
  name: PAYMENT-invalid acknowledge signed unpaid event
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/webhooks/stripe
  body: text
}

headers {
  content-type: application/json
}

body:text {
  {}
}

vars:pre-request {
  actor: external
}

script:pre-request {
  req.setHeader("stripe-signature", bru.getVar("unpaidWebhookSignature"));
  req.setBody(bru.getVar("unpaidWebhookPayload"), { raw: true });
}

tests {
  test("acknowledges unpaid signed events without activating enrollment", function() {
    expect(res.status).to.equal(200);
    expect(res.body.received).to.equal(true);
  });
}
