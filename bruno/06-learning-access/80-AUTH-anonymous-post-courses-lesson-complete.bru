meta {
  name: Require session: POST /api/v1/courses/lesson/complete
  type: http
  seq: 80
}

post {
  url: {{baseUrl}}/api/v1/courses/lesson/complete
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "lessonId": "{{pendingLessonId}}"
  }
}


vars:pre-request {
  actor: anonymous
}

tests {
  test("rejects an anonymous request before business mutations", function() {
    expect(res.status).to.equal(401);
  });
}
