meta {
  name: Require session: POST /api/v1/admin/chapters/:chapterId/lessons
  type: http
  seq: 80
}

post {
  url: {{baseUrl}}/api/v1/admin/chapters/{{activeChapterId}}/lessons
  body: json
}

headers {
  content-type: application/json
}

body:json {
  { "name": "Forbidden lesson" }
}


vars:pre-request {
  actor: anonymous
}

tests {
  test("rejects an anonymous request before business mutations", function() {
    expect(res.status).to.equal(401);
  });
}
