meta {
  name: Enroll Payment Course
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/courses/enroll
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "courseId": "{{paymentCourseId}}"
  }
}

tests {
  test("initializes checkout for the payment course", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("status", "success");
    expect(res.body).to.have.property("message").that.includes("Enrollment initialized");
    expect(res.body).to.have.property("checkoutUrl").that.is.a("string");
    expect(res.body.checkoutUrl).to.match(/^https:\/\/checkout\.stripe\.com\//);
  });
}
