meta {
  name: Health
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/health
}

tests {
  test("returns 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("returns the health payload", function() {
    expect(res.body).to.deep.equal({ status: "ok" });
  });
}

vars:pre-request {
  actor: anonymous
}
