meta {
  name: Admin Create Lesson Invalid Body
  type: http
  seq: 28
}

post {
  url: {{baseUrl}}/api/v1/admin/chapters/{{seededChapterId}}/lessons
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": ""
  }
}

tests {
  test("admin lesson creation rejects invalid body", function() {
    expect(res.status).to.equal(400);
    expect(res.body).to.have.property("status", "error");
    expect(res.body).to.have.property("message").that.is.a("string");
  });
}
