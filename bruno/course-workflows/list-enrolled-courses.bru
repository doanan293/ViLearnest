meta {
  name: List Enrolled Courses
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/courses/enrolled
}

tests {
  test("includes the seeded active enrollment", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("array");
    const enrollment = res.body.find((item) => item.Course?.id === bru.getEnvVar("seededCourseId"));
    expect(enrollment).to.be.an("object");
    expect(enrollment).to.have.property("status", "Active");
  });
}
