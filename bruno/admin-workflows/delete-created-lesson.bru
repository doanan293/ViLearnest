meta {
  name: Delete Created Lesson
  type: http
  seq: 21
}

delete {
  url: {{baseUrl}}/api/v1/admin/lessons/{{adminCreatedLessonId}}
}

tests {
  test("deletes the API-created lesson", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("status", "success");
  });
}
