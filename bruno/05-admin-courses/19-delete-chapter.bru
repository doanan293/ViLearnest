meta {
  name: ADMIN-cascade delete chapter
  type: http
  seq: 19
}

delete {
  url: {{baseUrl}}/api/v1/admin/chapters/{{createdChapterBId}}
}

vars:pre-request {
  actor: admin
}

tests {
  test("deletes one owned chapter with its descendants", function() {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("success");
  });
}
