meta {
  name: Payment Course In Enrolled List
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/courses/enrolled
}

tests {
  test("includes the activated payment enrollment", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("array");
    const enrollment = res.body.find((item) => item.Course?.id === bru.getEnvVar("paymentCourseId"));
    expect(enrollment).to.be.an("object");
    expect(enrollment).to.have.property("status", "Active");
  });
}
