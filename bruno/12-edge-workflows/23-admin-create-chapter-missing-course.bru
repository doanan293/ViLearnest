meta {
  name: Admin Create Chapter Missing Course
  type: http
  seq: 23
}

post {
  url: {{baseUrl}}/api/v1/admin/courses/bruno-missing-course/chapters
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "Missing Course Chapter"
  }
}

tests {
  test("returns not found when creating a chapter for a missing course", function() {
    expect(res.status).to.equal(404);
    expect(res.body).to.have.property("status", "error");
    expect(res.body).to.have.property("message").that.includes("Course not found");
  });
}
