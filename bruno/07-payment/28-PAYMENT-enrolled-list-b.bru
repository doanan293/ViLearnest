meta {
  name: PAYMENT-enrolled keep learner B list isolated
  type: http
  seq: 29
}

get {
  url: {{baseUrl}}/api/v1/courses/enrolled
}

vars:pre-request {
  actor: learnerB
}

tests {
  test("keeps the paid course out of learner B's enrolled list", function() {
    expect(res.status).to.equal(200);
    expect(res.body.some((row) => row.courseId === bru.getVar("pendingCourseId"))).to.equal(false);
  });
}
