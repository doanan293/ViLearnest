meta {
  name: Get Created Course
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/api/v1/admin/courses/{{adminCreatedCourseId}}
}

tests {
  test("returns the API-created course structure", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("id", bru.getVar("adminCreatedCourseId"));
    expect(res.body.chapter[0]).to.have.property("id", bru.getVar("adminCreatedChapterId"));
    expect(res.body.chapter[0].lessons[0]).to.have.property("id", bru.getVar("adminCreatedLessonId"));
  });
}
