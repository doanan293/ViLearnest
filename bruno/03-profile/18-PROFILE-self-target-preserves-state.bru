meta {
  name: PROFILE-self-target-preserves-state
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/api/v1/profile/me
}

vars:pre-request {
  actor: learnerA
}

tests {
  test("keeps the caller profile unchanged after rejecting target IDs", function() {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(bru.getVar("learnerAId"));
    expect(res.body.name).to.equal("Self Target Remained Caller");
  });
}
