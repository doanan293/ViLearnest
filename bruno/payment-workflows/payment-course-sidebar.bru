meta {
  name: Payment Course Sidebar
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/courses/by-slug/{{paymentCourseSlug}}/sidebar
}

tests {
  test("returns sidebar for the activated payment course", function() {
    expect(res.status).to.equal(200);
    expect(res.body.course).to.have.property("id", bru.getEnvVar("paymentCourseId"));
    expect(res.body.course.chapter[0].lessons[0]).to.have.property("id", bru.getEnvVar("paymentLessonId"));
  });
}
