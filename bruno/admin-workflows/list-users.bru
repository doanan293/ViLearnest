meta {
  name: List Users
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/admin/users/
}

tests {
  test("lists seeded Bruno users", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("array");
    expect(res.body.some((user) => user.email === bru.getEnvVar("userEmail"))).to.equal(true);
    expect(res.body.some((user) => user.email === bru.getEnvVar("adminEmail"))).to.equal(true);
  });
}
