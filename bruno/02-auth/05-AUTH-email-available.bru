meta {
  name: 05-AUTH-email-available
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/auth/email-exists
  body: json
}

headers {
  content-type: application/json
}

body:json {
  { "email": "{{learnerAEmail}}" }
}

vars:pre-request {
  actor: anonymous
}

tests {
  test("05-AUTH-email-available", function() {
    expect(res.status).to.equal(200);
    expect(res.body.exists).to.equal(false);
  });
}
