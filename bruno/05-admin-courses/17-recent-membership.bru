meta {
  name: ADMIN-stats recent course membership
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/api/v1/admin/courses/recent
}

vars:pre-request {
  actor: admin
}

tests {
  test("includes the recently created owned course without assuming row order", function() {
    expect(res.status).to.equal(200);
    expect(res.body.some((course) => course.id === bru.getVar("createdCourseId"))).to.equal(true);
  });
}
