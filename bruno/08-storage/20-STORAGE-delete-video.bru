meta {
  name: STORAGE-delete video object
  type: http
  seq: 20
}

delete {
  url: {{baseUrl}}/api/v1/storage/files
  body: json
}

headers {
  content-type: application/json
}

body:json {
  { "key": "{{videoKey}}" }
}

vars:pre-request {
  actor: learnerA
}

tests {
  test("deletes the video through the authenticated storage API", function() { expect(res.status).to.equal(200); });
}
