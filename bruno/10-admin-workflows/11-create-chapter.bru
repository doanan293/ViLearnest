meta {
  name: Create Chapter
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/admin/courses/{{adminCreatedCourseId}}/chapters
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "Bruno Workflow Chapter"
  }
}

script:post-response {
  bru.setVar("adminCreatedChapterId", res.body.chapter.id);
}

tests {
  test("creates a chapter in the API-created course", function() {
    expect(res.status).to.equal(200);
    expect(res.body.chapter).to.have.property("id").that.is.a("string");
    expect(res.body.chapter).to.have.property("title", "Bruno Workflow Chapter");
  });
}
