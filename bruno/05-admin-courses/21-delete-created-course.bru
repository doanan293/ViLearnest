meta {
  name: ADMIN-cascade delete owned course
  type: http
  seq: 21
}

delete {
  url: {{baseUrl}}/api/v1/admin/courses/{{createdCourseId}}
}

vars:pre-request {
  actor: admin
}

tests {
  test("deletes the owned course and remaining descendants", function() {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("success");
  });
}
