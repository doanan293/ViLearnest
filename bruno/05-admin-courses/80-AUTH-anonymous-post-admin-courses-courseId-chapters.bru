meta {
  name: Require session: POST /api/v1/admin/courses/:courseId/chapters
  type: http
  seq: 80
}

post {
  url: {{baseUrl}}/api/v1/admin/courses/{{publishedCourseId}}/chapters
  body: json
}

headers {
  content-type: application/json
}

body:json {
  { "nameEn": "Forbidden chapter" }
}


vars:pre-request {
  actor: anonymous
}

tests {
  test("rejects an anonymous request before business mutations", function() {
    expect(res.status).to.equal(401);
  });
}
