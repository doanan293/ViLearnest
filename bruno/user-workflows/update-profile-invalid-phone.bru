meta {
  name: Update Profile Invalid Phone
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/v1/profile/me
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "Bruno Learner Updated",
    "phoneNumber": "not-a-phone"
  }
}

tests {
  test("rejects invalid phone number", function() {
    expect(res.status).to.equal(400);
    expect(res.body).to.have.property("status", "error");
    expect(res.body).to.have.property("message").that.includes("phoneNumber");
  });
}
