meta {
  name: Checkout Confirm Negative
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/courses/checkout/confirm
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "sessionId": "cs_test_bruno_invalid"
  }
}

tests {
  test("returns a handled error for an invalid checkout session", function() {
    expect([400, 404]).to.include(res.status);
    expect(res.body).to.have.property("status", "error");
    expect(res.body).to.have.property("message").that.is.a("string");
  });
}
