meta {
  name: Sign In Reset Password Lifecycle User
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/auth/sign-in/email
  body: json
}

headers {
  content-type: application/json
  origin: {{frontendUrl}}
}

body:json {
  {
    "email": "{{lifecycleEmail}}",
    "password": "{{lifecycleResetPassword}}"
  }
}

tests {
  test("signs in with the reset lifecycle password", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("token").that.is.a("string");
    expect(res.body.user).to.have.property("email", bru.getEnvVar("lifecycleEmail"));
    expect(res.body.user).to.have.property("emailVerified", true);
  });
}
