meta {
  name: Verify Lifecycle Session
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/auth/session
}

tests {
  test("returns the active lifecycle user session", function() {
    expect(res.status).to.equal(200);
    expect(res.body.user).to.have.property("email", bru.getEnvVar("lifecycleEmail"));
    expect(res.body.session).to.have.property("userId").that.is.a("string");
  });
}
