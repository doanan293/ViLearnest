meta {
  name: Email Exists Lifecycle User
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/email-exists
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "email": "{{lifecycleEmail}}"
  }
}

tests {
  test("email exists returns true after lifecycle sign-up", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("exists", true);
  });
}
