meta {
  name: PAYMENT-pending verify access is locked
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/courses/{{pendingCourseId}}/is-enrolled
}

vars:pre-request {
  actor: learnerA
}

tests {
  test("pending enrollment does not grant course access", function() {
    expect(res.status).to.equal(200);
    expect(res.body.enrolled).to.equal(false);
  });
}
