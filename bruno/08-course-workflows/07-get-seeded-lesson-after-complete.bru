meta {
  name: Get Seeded Lesson After Complete
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/courses/lessons/{{seededLessonId}}
}

tests {
  test("shows completed progress after marking the lesson complete", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("id", bru.getEnvVar("seededLessonId"));
    expect(res.body.lessonProgess).to.be.an("array");
    const progress = res.body.lessonProgess.find((item) => item.completed === true);
    expect(progress).to.be.an("object");
  });
}
