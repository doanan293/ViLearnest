meta {
  name: Desktop Check Storage Env
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/bruno-desktop/storage-env
}

headers {
  x-bruno-helper-token: {{brunoDesktopHelperToken}}
}

tests {
  test("validates storage environment for Desktop runs", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.deep.equal({ ok: true });
  });
}
