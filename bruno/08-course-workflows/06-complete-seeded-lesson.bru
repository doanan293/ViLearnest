meta {
  name: Complete Seeded Lesson
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/courses/lesson/complete
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "lessonId": "{{seededLessonId}}",
    "slug": "{{seededCourseSlug}}"
  }
}

tests {
  test("marks the seeded lesson complete", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("status", "success");
    expect(res.body).to.have.property("message").that.is.a("string");
  });
}
