meta {
  name: Verify User Session
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/auth/session
}

tests {
  test("returns the active user session", function() {
    expect(res.status).to.equal(200);
    expect(res.body.user).to.have.property("email", bru.getEnvVar("userEmail"));
    expect(res.body.user).to.have.property("role", "user");
    expect(res.body.session).to.have.property("userId", bru.getEnvVar("seededUserId"));
  });
}
