meta {
  name: PAYMENT-replay active enrollment does not create checkout
  type: http
  seq: 30
}

post {
  url: {{baseUrl}}/api/v1/courses/enroll
  body: json
}

headers {
  content-type: application/json
}

body:json {
  { "courseId": "{{pendingCourseId}}" }
}

vars:pre-request {
  actor: learnerA
}

tests {
  test("returns the existing active enrollment without another checkout URL", function() {
    expect(res.status).to.equal(200);
    expect(res.body.checkoutUrl).to.be.undefined;
    expect(res.body.message).to.include("already enrolled");
  });
}
