meta {
  name: Login Admin
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/auth/sign-in/email
  body: json
}

headers {
  content-type: application/json
  origin: {{frontendUrl}}
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

script:post-response {
  if (res.body && res.body.token) {
    bru.setVar("authToken", res.body.token);
  }
}

tests {
  test("logs in the seeded admin", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("token").that.is.a("string");
    expect(res.body.user).to.have.property("email", bru.getEnvVar("adminEmail"));
    expect(res.body.user).to.have.property("role", "admin");
  });
}
