meta {
  name: 18-LEARN-enrolled-membership
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/api/v1/courses/enrolled
}

vars:pre-request {
  actor: learnerA
}

tests {
  test("18-LEARN-enrolled-membership", function() {
    expect(res.status).to.equal(200);
    expect(res.body.some((row) => row.Course.slug === bru.getVar("activeSlug"))).to.equal(true);
    expect(res.body.some((row) => row.Course.slug === bru.getVar("pendingSlug"))).to.equal(false);
  });
}
