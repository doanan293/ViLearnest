meta {
  name: PAYMENT-enrolled verify learner A access
  type: http
  seq: 25
}

get {
  url: {{baseUrl}}/api/v1/courses/{{pendingCourseId}}/is-enrolled
}

vars:pre-request {
  actor: learnerA
}

tests {
  test("paid enrollment grants access to learner A", function() {
    expect(res.status).to.equal(200);
    expect(res.body.enrolled).to.equal(true);
  });
}
