meta {
  name: ADMIN-crud verify course update
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/admin/courses/{{createdCourseId}}
}

vars:pre-request {
  actor: admin
}

tests {
  test("persists the updated title, level and duration", function() {
    expect(res.status).to.equal(200);
    expect(res.body.title).to.equal("Bruno Owned Admin Course Updated");
    expect(res.body.level).to.equal("Intermediate");
    expect(res.body.duration).to.equal(50);
  });
}
