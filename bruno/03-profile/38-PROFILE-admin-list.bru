meta {
  name: PROFILE-admin-list
  type: http
  seq: 38
}

get {
  url: {{baseUrl}}/api/v1/admin/users
}

vars:pre-request {
  actor: admin
}

tests {
  test("allows admin to list both run learners", function() {
    expect(res.status).to.equal(200);
    expect(res.body.some((user) => user.id === bru.getVar("learnerAId"))).to.equal(true);
    expect(res.body.some((user) => user.id === bru.getVar("learnerBId"))).to.equal(true);
  });
}
