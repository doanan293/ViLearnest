meta {
  name: ADMIN-authorization learner denied chapter reorder
  type: http
  seq: 37
}

post {
  url: {{baseUrl}}/api/v1/admin/chapters/reorder
  body: json
}

headers {
  content-type: application/json
}

body:json {
  { "items": [{ "id": "{{activeChapterId}}", "position": 1 }] }
}

vars:pre-request {
  actor: learnerA
}

tests {
  test("denies a valid chapter reorder to an authenticated learner", function() { expect(res.status).to.equal(403); });
}
