meta {
  name: Reset Password Lifecycle User
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/auth/email-otp/reset-password
  body: text
}

headers {
  content-type: application/json
  origin: {{frontendUrl}}
}

body:text {
  {}
}

script:pre-request {
  const lifecycleEmail = bru.getVar("lifecycleEmail") || bru.getEnvVar("lifecycleEmail");
  const lifecycleOtp = bru.getVar("lifecycleOtp") || bru.getEnvVar("lifecycleOtp");
  const lifecycleResetPassword = bru.getVar("lifecycleResetPassword") || bru.getEnvVar("lifecycleResetPassword");

  if (!lifecycleEmail) {
    throw new Error("lifecycleEmail is required");
  }
  if (!lifecycleOtp) {
    throw new Error("lifecycleOtp is required");
  }
  if (!lifecycleResetPassword) {
    throw new Error("lifecycleResetPassword is required");
  }

  req.setBody(JSON.stringify({
    email: lifecycleEmail,
    otp: lifecycleOtp,
    password: lifecycleResetPassword,
  }), { raw: true });
}

tests {
  test("resets the lifecycle user password with the exported OTP", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("success", true);
  });
}
