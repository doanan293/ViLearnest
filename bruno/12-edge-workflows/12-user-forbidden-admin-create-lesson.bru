meta {
  name: User Forbidden Admin Create Lesson
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/admin/chapters/{{seededChapterId}}/lessons
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "Blocked User Lesson"
  }
}

tests {
  test("normal user cannot create admin lessons", function() {
    expect(res.status).to.equal(403);
    expect(res.body).to.have.property("status", "error");
    expect(res.body).to.have.property("message").that.includes("Administrator");
  });
}
