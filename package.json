{
  "name": "andv-lms-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@andv-lms/backend & npm run dev --workspace=@andv-lms/frontend",
    "build": "npm run build --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=@andv-lms/backend",
    "db:migrate": "npm run db:migrate --workspace=@andv-lms/backend",
    "db:import-courses": "npm run db:import-courses --workspace=@andv-lms/backend",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspaces --if-present",
    "biome:ci": "npm run biome:ci --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "test:api": "npm run db:seed-bruno-api --workspace=@andv-lms/backend && cd bruno && bru run --env local",
    "test:api:smoke": "cd bruno && bru run 01-system 02-auth-contract 03-public-courses 04-protected-routes 05-admin-routes 06-storage --env local",
    "test:api:workflows": "node scripts/run-bruno-workflows.mjs",
    "test:api:payment": "node scripts/run-bruno-payment.mjs",
    "test:api:edge": "node scripts/run-bruno-edge-lifecycle.mjs",
    "test:api:all": "npm run db:seed-bruno-api --workspace=@andv-lms/backend && cd bruno && bru run --env local"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@usebruno/cli": "3.5.0",
    "jest": "^30.4.2",
    "pptxgenjs": "^4.0.1",
    "ts-jest": "^29.4.11"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "uuid": "^13.0.2",
    "esbuild": "^0.28.1"
  }
}
